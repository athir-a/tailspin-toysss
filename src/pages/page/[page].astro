---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import GameCard from '../../components/GameCard.astro';
import PageHero from '../../components/PageHero.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getDatabase } from '../../lib/db';
import { DEFAULT_GAMES_PAGE_SIZE, getGamesPage } from '../../lib/games';

export const prerender = true;

export const getStaticPaths = (async () => {
  const totalPages = (await getGamesPage(getDatabase(), { page: 1, limit: DEFAULT_GAMES_PAGE_SIZE })).totalPages;
  return Array.from({ length: totalPages }, (_, index) => ({ params: { page: String(index + 1) } }));
}) satisfies GetStaticPaths;

const { page } = Astro.params;
const currentPage = Number(page ?? '1');
const result = await getGamesPage(getDatabase(), { page: currentPage, limit: DEFAULT_GAMES_PAGE_SIZE });
const games = result.games;
const totalPages = result.totalPages;
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <nav
            class="mt-8 flex flex-wrap items-center justify-center gap-3"
            aria-label="Game list pagination"
            data-testid="pagination-nav"
          >
            <a
              href={result.hasPreviousPage ? `/page/${result.page - 1}` : '#'}
              class:list={[
                'inline-flex items-center justify-center rounded-lg border px-3 py-2 text-sm font-medium transition-colors duration-200',
                result.hasPreviousPage
                  ? 'border-slate-600 bg-slate-800 text-slate-100 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none'
                  : 'pointer-events-none cursor-not-allowed border-slate-700 bg-slate-900 text-slate-500',
              ]}
              aria-label="Previous page"
              aria-disabled={!result.hasPreviousPage}
              data-testid="pagination-previous"
            >
              Previous
            </a>

            {pageNumbers.map((pageNumber) => (
              <a
                href={`/page/${pageNumber}`}
                class:list={[
                  'inline-flex h-10 w-10 items-center justify-center rounded-lg border text-sm font-medium transition-colors duration-200',
                  pageNumber === result.page
                    ? 'border-blue-500 bg-blue-600 text-white'
                    : 'border-slate-600 bg-slate-800 text-slate-100 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none',
                ]}
                aria-label={`Go to page ${pageNumber}`}
                aria-current={pageNumber === result.page ? 'page' : undefined}
                data-testid={`pagination-page-${pageNumber}`}
              >
                {pageNumber}
              </a>
            ))}

            <a
              href={result.hasNextPage ? `/page/${result.page + 1}` : '#'}
              class:list={[
                'inline-flex items-center justify-center rounded-lg border px-3 py-2 text-sm font-medium transition-colors duration-200',
                result.hasNextPage
                  ? 'border-slate-600 bg-slate-800 text-slate-100 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none'
                  : 'pointer-events-none cursor-not-allowed border-slate-700 bg-slate-900 text-slate-500',
              ]}
              aria-label="Next page"
              aria-disabled={!result.hasNextPage}
              data-testid="pagination-next"
            >
              Next
            </a>
          </nav>
        </>
      )}
    </div>
  </div>
</Layout>
